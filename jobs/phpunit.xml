<?xml version="1.0" encoding="UTF-8"?>
<phpunit 
    bootstrap="vendor/autoload.php"
    colors="true"
    verbose="true"
    stopOnFailure="false"
    cacheResult="false"
>

    <testsuites>
        <testsuite name="Jo's Jobs Tests">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <coverage>
        <include>
            <directory suffix=".php">src</directory>
        </include>
        <exclude>
            <directory suffix=".php">src/Framework/RoutesInterface.php</directory>
        </exclude>
        <report>
            <html outputDirectory="coverage-report"/>
            <clover outputFile="coverage-report/clover.xml"/>
            <text outputFile="coverage-report/coverage.txt"/>
        </report>
    </coverage>

</phpunit>